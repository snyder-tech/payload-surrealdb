{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "import", "unicorn"],
  "categories": {
    "correctness": "error",
    "suspicious": "warn"
  },
  "rules": {
    "typescript/no-explicit-any": "error",
    "no-underscore-dangle": [
      "warn",
      {
        "allow": ["_status", "_splat"]
      }
    ]
  },
  "ignorePatterns": ["**/node_modules/**", "**/dist/**", "docs/**"]
}
